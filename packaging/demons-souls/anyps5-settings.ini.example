# AnyPS5 display settings for Demon's Souls. The settings window at each start writes anyps5-settings.ini
# (next to the game executable); or rename this file to anyps5-settings.ini and edit it. A key left out,
# or set to auto, keeps the default: the window opens at 60% of the screen and the game's own graphics
# mode picks the render resolution and the frame rate.
# Each key has an environment variable that overrides it (APS5_RESOLUTION, APS5_FPS_LIMIT, ...).

# Output resolution: the window's size (any WIDTHxHEIGHT; the image keeps 16:9 and is letterboxed).
# It also picks the game's render resolution: 900p up to 1600x900 (and the Steam Deck), 1080p up to
# 1920x1080, 1440p above. Common sizes: 1280x720, 1280x800 (Steam Deck), 1600x900, 1920x1080,
# 1920x1200, 2560x1080, 2560x1440, 2560x1600, 3440x1440, 3840x2160.
# Resolution = 1920x1080

# Render resolution by hand: auto, 900, 1080, 1440 or 2160 (2160 is the game's cinematic setting).
# RenderResolution = auto

# Native aspect: on renders at Resolution's own aspect (21:9, 32:9, 16:10, ...) with a wider or taller
# view instead of a letterboxed 16:9 image. Needs Resolution = WIDTHxHEIGHT. Experimental.
# The environment switches APS5_NATIVE_ASPECT_RENDER=1 (post effects break) and APS5_NATIVE_ASPECT_UI=1
# (bottom HUD cut off wider than 16:9) are more experimental still.
# NativeAspect = off

# Frame rate limit: auto, 30, 60, or any value from 20 to 240 with Timestep = variable.
# FpsLimit = 60

# The game advances one fixed 1/60 s step per frame, so below the limit it runs in slow motion.
# variable: each step follows the measured frame time (down to TimestepMinHz), so the game keeps its
# speed at any frame rate. Needed for limits other than 30 and 60. Experimental.
# Timestep = fixed
# TimestepMinHz = 19.98

# Present mode, experimental: read only with the environment switch APS5_PRESENT_AUTO=1 for now.
# auto: mailbox when the frame rate limit is above the display's refresh, else fifo. fifo waits for the
# display; mailbox shows the newest frame at each refresh (drops frames, never tears); immediate tears.
# PresentMode = auto

# windowed or fullscreen (fullscreen uses the desktop resolution; F11 toggles it).
# WindowMode = windowed

# Button icons in the prompts: playstation or steamdeck (A, B, X, Y, Menu and View, drawn by the port;
# View then works as the touchpad).
# ButtonIcons = playstation

# Upscaler: off. AMD FSR and NVIDIA DLSS are planned.
# Upscaler = off

# The Deluxe Edition add-on (Fluted armour set): auto = owned when your dump holds it (a folder next to
# the game folder named with DEMONSSOULSGIFT2 or its content id), off = not owned even then. Nothing is
# written into the dump. AddonDir names a folder holding your dumped add-ons when they are elsewhere.
# DeluxeEdition = auto
# AddonDir = "D:\Dumps\PPSA01341-ac"
