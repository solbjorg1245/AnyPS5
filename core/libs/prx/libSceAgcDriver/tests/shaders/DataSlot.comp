layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Words { uint words[]; };
layout(set = 0, binding = 1, std430) buffer Results { uint results[]; };

void main() {
    results[words[1]] = words[0];
}
