#version 450

// APS5_MFSR_EXEC's bilinear stand-in for the PS5 Pro upscaler (docs/design/dlss.md S1; recorded by
// Graphics/src/Upscale.cpp): every output texel samples MainColor at its center's place in the render
// rectangle, clamped half a texel inside it (Upscale::Plan). The output is a storage view of the
// guest's own format, written without a format qualifier (shaderStorageImageWriteWithoutFormat).
// MainColor holds the game's compressed colour c / (1 + luma); bit 0 of flags writes it expanded,
// c / (1 - luma) (APS5_UPSCALER_EXPAND=1, Upscale::ExpandEnabled); bit 1 multiplies it by the exposure
// texel, as the game's TAA pass multiplies MainColor (APS5_UPSCALER_EXPOSURE, Upscale::ExposureEnabled).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D color;
layout(set = 0, binding = 1) uniform writeonly image2D target;
layout(set = 0, binding = 2) uniform sampler2D exposure;

layout(push_constant, std430) uniform Parameters {
    uvec2 size;
    vec2 scale;
    vec2 low;
    vec2 high;
    uint flags;
};

vec4 expanded(vec4 colour) {
    float luma = min(dot(colour.rgb, vec3(0.3, 0.59, 0.11)), 0.9995);
    return vec4(colour.rgb / (1.0 - luma), colour.a);
}

void main() {
    uvec2 texel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(texel, min(size, uvec2(imageSize(target)))))) {
        return;
    }
    vec2 position = clamp((vec2(texel) + 0.5) * scale, low, high);
    vec4 colour = textureLod(color, position, 0.0);
    if ((flags & 1u) != 0u) {
        colour = expanded(colour);
    }
    if ((flags & 2u) != 0u) {
        colour.rgb *= texelFetch(exposure, ivec2(0), 0).r;
    }
    imageStore(target, ivec2(texel), colour);
}
