#version 450

// APS5_UPSCALER_PORT's temporal upscaler (docs/design/dlss.md S2; recorded by Graphics/src/Upscale.cpp,
// planned by Upscale::PlanTemporal). Per output texel: the current colour reconstructed from the 3x3
// MainColor texels around its place in the render rectangle, each weighted by its jittered sample's
// distance; the motion of the 3x3's nearest-depth texel times the MV scale as the offset (render
// pixels) to its place last frame; the history fetched there (Catmull-Rom from 5 bilinear taps),
// clipped to the 3x3's YCoCg box and blended with the current colour (all current on a reset or when
// last frame's place is off screen). The result goes to the next history image and to the output (a
// storage view of the guest's own format, written without a format qualifier).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D color;
layout(set = 0, binding = 1) uniform sampler2D motion;
layout(set = 0, binding = 2) uniform sampler2D depth;
layout(set = 0, binding = 3) uniform sampler2D history;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D nextHistory;
layout(set = 0, binding = 5) uniform writeonly image2D target;

layout(push_constant, std430) uniform Parameters {
    uvec2 size;
    uvec2 render;
    // Render pixels: render texel i's sample lies at i + 0.5 - jitter; Motion times motionScale is the
    // offset from a texel to its place last frame.
    vec2 jitter;
    vec2 motionScale;
    // +0x118 (1.0 so far): scales the luma that weights the blend.
    float exposure;
    float currentWeight;
    // Bit 0: reset (the history is not read); bit 1: the nearest depth is the smallest (else reversed Z).
    uint flags;
};

vec3 toYCoCg(vec3 rgb) {
    return vec3(dot(rgb, vec3(0.25, 0.5, 0.25)), dot(rgb, vec3(0.5, 0.0, -0.5)), dot(rgb, vec3(-0.25, 0.5, -0.25)));
}

vec3 fromYCoCg(vec3 ycocg) {
    return vec3(ycocg.x + ycocg.y - ycocg.z, ycocg.x + ycocg.z, ycocg.x - ycocg.y - ycocg.z);
}

// Last frame's history at `uv`: the 4x4 Catmull-Rom kernel without its corners, from 5 bilinear taps.
vec3 fetchHistory(vec2 uv) {
    vec2 extent = vec2(size);
    vec2 position = uv * extent;
    vec2 base = floor(position - 0.5) + 0.5;
    vec2 f = position - base;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 at0 = (base - 1.0) / extent;
    vec2 at3 = (base + 2.0) / extent;
    vec2 at12 = (base + w2 / w12) / extent;
    vec3 sum = textureLod(history, vec2(at12.x, at0.y), 0.0).rgb * (w12.x * w0.y) + textureLod(history, vec2(at0.x, at12.y), 0.0).rgb * (w0.x * w12.y)
        + textureLod(history, at12, 0.0).rgb * (w12.x * w12.y) + textureLod(history, vec2(at3.x, at12.y), 0.0).rgb * (w3.x * w12.y)
        + textureLod(history, vec2(at12.x, at3.y), 0.0).rgb * (w12.x * w3.y);
    float weight = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(sum / weight, vec3(0.0));
}

void main() {
    uvec2 texel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(texel, min(size, uvec2(imageSize(target)))))) {
        return;
    }
    vec2 uv = (vec2(texel) + 0.5) / vec2(size);
    // The texel's place in render pixels, and the render texel whose jittered sample is nearest to it.
    vec2 place = uv * vec2(render);
    ivec2 nearest = ivec2(floor(place + jitter));
    ivec2 last = ivec2(render) - 1;
    bool smallestNearest = (flags & 2u) != 0u;
    vec3 sum = vec3(0.0), low = vec3(1e30), high = vec3(-1e30), moment = vec3(0.0), moment2 = vec3(0.0);
    float weights = 0.0, closest = smallestNearest ? 1e30 : -1e30;
    ivec2 closestAt = clamp(nearest, ivec2(0), last);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 at = clamp(nearest + ivec2(x, y), ivec2(0), last);
            vec3 rgb = max(texelFetch(color, at, 0).rgb, vec3(0.0));
            // A Gaussian close to Blackman-Harris over the sample's distance to the place.
            vec2 offset = vec2(nearest + ivec2(x, y)) + 0.5 - jitter - place;
            float weight = exp(-2.29 * dot(offset, offset));
            sum += rgb * weight;
            weights += weight;
            vec3 ycocg = toYCoCg(rgb);
            low = min(low, ycocg);
            high = max(high, ycocg);
            moment += ycocg;
            moment2 += ycocg * ycocg;
            float z = texelFetch(depth, min(at, textureSize(depth, 0) - 1), 0).r;
            if (smallestNearest ? z < closest : z > closest) {
                closest = z;
                closestAt = at;
            }
        }
    }
    vec3 current = sum / max(weights, 1e-6);
    vec2 offset = texelFetch(motion, min(closestAt, textureSize(motion, 0) - 1), 0).rg * motionScale;
    vec2 previous = uv + offset / vec2(render);
    vec3 result = current;
    if ((flags & 1u) == 0u && all(greaterThanEqual(previous, vec2(0.0))) && all(lessThanEqual(previous, vec2(1.0)))) {
        // The 3x3's YCoCg box: its min and max narrowed to mean +- 1.25 sigma; the history clipped
        // toward the box's centre.
        vec3 mean = moment / 9.0;
        vec3 sigma = sqrt(max(moment2 / 9.0 - mean * mean, vec3(0.0)));
        vec3 boxLow = max(low, mean - 1.25 * sigma), boxHigh = min(high, mean + 1.25 * sigma);
        vec3 centre = 0.5 * (boxLow + boxHigh), extent = 0.5 * (boxHigh - boxLow) + 1e-4;
        vec3 past = toYCoCg(fetchHistory(previous));
        vec3 ratio = abs((past - centre) / extent);
        float largest = max(ratio.x, max(ratio.y, ratio.z));
        if (largest > 1.0) {
            past = centre + (past - centre) / largest;
        }
        // Each side weighted down by its luma, so bright samples do not flicker.
        float currentShare = currentWeight / (1.0 + toYCoCg(current).x * exposure);
        float pastShare = (1.0 - currentWeight) / (1.0 + max(past.x, 0.0) * exposure);
        result = (current * currentShare + fromYCoCg(past) * pastShare) / (currentShare + pastShare);
    }
    // A NaN or an infinity would stay in the history: dropped; the rest kept within half floats (a
    // clipped history can leave the RGB cube a little).
    if (any(isnan(result)) || any(isinf(result))) {
        result = vec3(0.0);
    }
    result = clamp(result, vec3(0.0), vec3(65504.0));
    float alpha = texelFetch(color, clamp(nearest, ivec2(0), last), 0).a;
    imageStore(nextHistory, ivec2(texel), vec4(result, 1.0));
    imageStore(target, ivec2(texel), vec4(result, alpha));
}
